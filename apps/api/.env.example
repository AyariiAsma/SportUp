# ─── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sportup?schema=public"

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-random-secret-in-production"
JWT_REFRESH_SECRET="change-this-to-another-random-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── Server ──────────────────────────────────────────────
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"

# ─── Media Storage (local for MVP) ───────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50

# ─── Future: AWS S3 ─────────────────────────────────────
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION=""
# AWS_S3_BUCKET=""
