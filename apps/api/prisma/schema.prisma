generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── SPORTS ──────────────────────────────────────────────
// Extensible sport catalogue — add new sports without code changes

model Sport {
  id        String   @id @default(cuid())
  name      String   @unique // "running", "cycling", "football"
  label     String // "Running", "Cycling", "Football"
  icon      String // icon name or URL
  color     String // brand color hex
  metadata  Json? // sport-specific config: { hasRoute, hasDistance, ... }
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  events Event[]

  @@map("sports")
}

// ─── USERS ───────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String?
  name            String
  username        String   @unique
  avatar          String?
  bio             String?
  city            String?
  region          String? // Maps to Governorate
  locality        String?
  additionalAddress String?
  country         String?
  lat             Float?
  lng             Float?
  runningLevel    RunningLevel @default(BEGINNER)
  rankScore       Int          @default(0)
  preferredSports String[]     // array of sport IDs
  totalDistanceKm Float        @default(0)
  googleId        String?      @unique
  appleId         String?      @unique
  isVerified      Boolean      @default(false)
  isActive        Boolean  @default(true)
  isOnline        Boolean  @default(false)
  lastSeenAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organizedEvents Event[]            @relation("Organizer")
  participations  EventParticipant[]
  runSessions     RunSession[]
  posts           Post[]
  reels           Reel[]
  followers       Follow[]           @relation("Following")
  following       Follow[]           @relation("Follower")
  sentReports     Report[]           @relation("Reporter")
  notifications   Notification[]
  settings        UserSettings?
  refreshTokens   RefreshToken[]
  comments        Comment[]
  likes           Like[]
  receivedInvitations EventInvitation[] @relation("Invitee")
  sentInvitations EventInvitation[] @relation("Inviter")
  postTags        PostTag[]
  createdSegments Segment[]
  segmentEfforts  SegmentEffort[]
  personalRecords PersonalRecord[]
  athleteGoals    AthleteGoal[]
  activityKudos   ActivityKudos[]
  privacyZones    PrivacyZone[]
  clubMemberships ClubMember[]
  clubPosts       ClubPost[]
  userChallenges  UserChallenge[]
  userBadges      UserBadge[]
  finisherResults EventFinisherResult[]
  eventAnnouncements EventAnnouncement[]

  @@map("users")
}

// ─── EVENTS ──────────────────────────────────────────────
// Sport-agnostic: the `metadata` JSON field holds sport-specific data

model Event {
  id              String      @id @default(cuid())
  title           String
  description     String
  sportId         String
  sport           Sport       @relation(fields: [sportId], references: [id])
  organizerId     String
  organizer       User        @relation("Organizer", fields: [organizerId], references: [id])
  status          EventStatus @default(DRAFT)
  difficulty      Difficulty?
  maxParticipants Int?
  startAt         DateTime
  endAt           DateTime?
  durationMin     Int? // estimated duration in minutes

  // Location
  locationName String?
  city         String?
  region       String? // Maps to Governorate
  locality     String?
  additionalAddress String?
  country      String?
  lat          Float?
  lng          Float?

  // Running-specific (extensible to other sports via metadata)
  distanceKm Float? // e.g. 5.0 for a 5 KM run

  // Media
  coverImage String?
  videoUrl   String?

  // Sport-specific metadata (extensible)
  metadata Json? // e.g. { elevation: 200, pace: '5:30/km' }

  participants EventParticipant[]
  invitations  EventInvitation[]
  comments     Comment[]
  likes        Like[]
  route        EventRoute?
  runSessions  RunSession[]

  recurrenceRule  String?
  seriesId        String?
  series          EventSeries?           @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  checkinToken    String?                @unique
  waitlistSize    Int                    @default(0)
  finisherResults EventFinisherResult[]
  announcements   EventAnnouncement[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([sportId])
  @@index([status])
  @@index([startAt])
  @@index([city])
  @@index([lat, lng])
  @@map("events")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  UPCOMING
  STARTED
  COMPLETED
  CANCELLED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ELITE
}

enum RunningLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// ─── EVENT PARTICIPANTS ──────────────────────────────────

model EventParticipant {
  id       String            @id @default(cuid())
  eventId  String
  event    Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId   String
  user     User              @relation(fields: [userId], references: [id])
  joinedAt DateTime          @default(now())
  status   ParticipantStatus @default(CONFIRMED)

  // Attendance — confirmed by the event organizer once the run happened
  attendance       AttendanceStatus @default(PENDING)
  attendanceAt     DateTime?
  pointsAwarded    Int              @default(0)
  distanceAwardedKm Float           @default(0)

  @@unique([eventId, userId])
  @@map("event_participants")
}

// ─── RUN SESSIONS (LIVE TRACKING) ────────────────────────

model RunSession {
  id                String             @id @default(cuid())
  clientSessionId   String?            @unique
  title             String             @default("Free Run")
  sportType         SportActivityType  @default(RUN)
  visibility        ActivityVisibility @default(PUBLIC)
  status            ActivityStatus     @default(COMPLETED)
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId           String?  // Optional: associated with an event
  event             Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  
  startTime         DateTime           @default(now())
  endTime           DateTime?
  distanceKm        Float              @default(0)
  durationSec       Int                @default(0)
  movingDurationSec Int                @default(0)
  avgPaceSec        Int                @default(0)
  avgSpeedKmh       Float              @default(0)
  maxSpeedKmh       Float              @default(0)
  elevationGainM    Float              @default(0)
  elevationLossM    Float              @default(0)
  calories          Int                @default(0)
  avgCadence        Int?
  avgHeartRate      Int?
  maxHeartRate      Int?
  isManual          Boolean            @default(false)
  sourceDevice      String?            @default("SportUp Mobile")
  notes             String?
  
  route             Json               // Array of location points
  splits            Json               // Array of split objects
  
  segmentEfforts    SegmentEffort[]
  personalRecords   PersonalRecord[]
  kudos             ActivityKudos[]
  post              Post?
  photos            String[]           @default([])
  hideMap           Boolean            @default(false)
  finisherResults   EventFinisherResult[]
  
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  
  @@index([userId, startTime])
  @@index([sportType])
  @@index([visibility])
  @@index([createdAt])
  @@map("run_sessions")
}

enum SportActivityType {
  RUN
  TRAIL_RUN
  WALK
  HIKE
  RIDE
  SWIM
  YOGA
  OTHER
}

enum ActivityVisibility {
  PUBLIC
  FOLLOWERS
  ONLY_ME
}

enum ActivityStatus {
  IN_PROGRESS
  COMPLETED
  DISCARDED
}


enum ParticipantStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
}

// ─── EVENT INVITATIONS ───────────────────────────────────

model EventInvitation {
  id          String             @id @default(cuid())
  eventId     String
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviterId   String
  inviter     User               @relation("Inviter", fields: [inviterId], references: [id])
  inviteeId   String
  invitee     User               @relation("Invitee", fields: [inviteeId], references: [id])
  status      InvitationStatus   @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([eventId, inviteeId])
  @@index([inviteeId, status])
  @@map("event_invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ─── EVENT ROUTES ────────────────────────────────────────
// Running, cycling, hiking routes — polyline on a map

model EventRoute {
  id          String   @id @default(cuid())
  eventId     String   @unique
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  points      Json // Array of { lat, lng, order }
  distanceKm  Float?
  encodedPath String? // Google Maps encoded polyline
  createdAt   DateTime @default(now())

  @@map("event_routes")
}

// ─── POSTS ───────────────────────────────────────────────

model Post {
  id        String       @id @default(cuid())
  authorId  String
  author    User         @relation(fields: [authorId], references: [id])
  content   String?
  category  PostCategory @default(GENERAL)
  isPublic  Boolean      @default(true)
  media     Media[]
  likes     Like[]
  comments  Comment[]
  tags      PostTag[]
  runSessionId String?      @unique
  runSession   RunSession?  @relation(fields: [runSessionId], references: [id], onDelete: SetNull)
  activityCardData Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([authorId])
  @@index([category])
  @@index([createdAt])
  @@map("posts")
}

enum PostCategory {
  GENERAL
  ADVICE
  MOTIVATION
  NUTRITION
  ACHIEVEMENT
  EVENT_PROMO
}

// ─── POST TAGS ───────────────────────────────────────────

model PostTag {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@map("post_tags")
}

// ─── REELS ───────────────────────────────────────────────

model Reel {
  id           String    @id @default(cuid())
  authorId     String
  author       User      @relation(fields: [authorId], references: [id])
  videoUrl     String
  thumbnailUrl String?
  caption      String?
  views        Int       @default(0)
  likes        Like[]
  comments     Comment[]
  createdAt    DateTime  @default(now())

  @@index([authorId])
  @@index([createdAt])
  @@map("reels")
}

// ─── MEDIA ───────────────────────────────────────────────

model Media {
  id        String    @id @default(cuid())
  url       String
  type      MediaType
  mimeType  String?
  sizeBytes Int?
  width     Int?
  height    Int?
  postId    String?
  post      Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("media")
}

enum MediaType {
  IMAGE
  VIDEO
  THUMBNAIL
}

// ─── LIKES ───────────────────────────────────────────────
// Polymorphic: can like posts or reels

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  reelId    String?
  reel      Reel?    @relation(fields: [reelId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@unique([userId, reelId])
  @@unique([userId, eventId])
  @@unique([userId, commentId])
  @@map("likes")
}

// ─── COMMENTS ────────────────────────────────────────────

model Comment {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  reelId    String?
  reel      Reel?    @relation(fields: [reelId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  parentCommentId String?
  parentComment   Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies         Comment[] @relation("CommentReplies")
  likes           Like[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([reelId])
  @@index([eventId])
  @@map("comments")
}

// ─── FOLLOWS ─────────────────────────────────────────────

model Follow {
  followerId  String
  followingId String
  follower    User     @relation("Follower", fields: [followerId], references: [id])
  following   User     @relation("Following", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@map("follows")
}

// ─── NOTIFICATIONS ───────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  data      Json? // { eventId, postId, userId, ... }
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  EVENT_INVITE
  EVENT_REMINDER
  EVENT_JOINED
  EVENT_CANCELLED
  EVENT_UPDATED
  EVENT_LIKED
  POST_LIKED
  POST_COMMENTED
  COMMENT_LIKED
  COMMENT_MENTION
  NEW_FOLLOWER
  NEW_FOLLOWER_EVENT
  NEW_NEARBY_EVENT
  ATTENDANCE_CONFIRMED
  RANK_UP
  ACTIVITY_KUDOS
  CHALLENGE_COMPLETED
  BADGE_EARNED
  EVENT_CHECKIN
  EVENT_RESULTS_READY
}

// ─── FOOD RECOMMENDATIONS ────────────────────────────────

model FoodRecommendation {
  id          String       @id @default(cuid())
  title       String
  description String
  category    FoodCategory
  imageUrl    String?
  tags        String[]
  isPublished Boolean      @default(true)
  createdAt   DateTime     @default(now())

  @@map("food_recommendations")
}

enum FoodCategory {
  MEAL
  RECIPE
  TIP
  RESTAURANT
}

// ─── REPORTS ─────────────────────────────────────────────

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id])
  targetType ReportTarget
  targetId   String
  reason     String
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  @@index([targetType, targetId])
  @@map("reports")
}

enum ReportTarget {
  POST
  REEL
  USER
  EVENT
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

// ─── USER SETTINGS ───────────────────────────────────────

model UserSettings {
  userId              String  @id
  user                User    @relation(fields: [userId], references: [id])
  notifyEventInvite   Boolean @default(true)
  notifyEventReminder Boolean @default(true)
  notifyPostLike      Boolean @default(true)
  notifyNewFollower   Boolean @default(true)
  notifyNearbyEvent   Boolean @default(true)
  locationSharingMode String  @default("none") // "gps" | "manual" | "none"
  showOnlineStatus    Boolean @default(true)

  @@map("user_settings")
}

// ─── REFRESH TOKENS ──────────────────────────────────────

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── SEGMENTS & LEADERBOARDS ─────────────────────────────

model Segment {
  id             String            @id @default(cuid())
  name           String
  sportType      SportActivityType @default(RUN)
  distanceM      Float
  startLat       Float
  startLng       Float
  endLat         Float
  endLng         Float
  polyline       Json              // Array of route points
  elevationGainM Float             @default(0)
  creatorId      String
  creator        User              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  efforts        SegmentEffort[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([startLat, startLng])
  @@index([sportType])
  @@index([creatorId])
  @@map("segments")
}

model SegmentEffort {
  id             String      @id @default(cuid())
  segmentId      String
  segment        Segment     @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  activityId     String
  activity       RunSession  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  elapsedTimeSec Int
  movingTimeSec  Int
  avgSpeedKmh    Float
  avgPaceSec     Int
  startDate      DateTime
  createdAt      DateTime    @default(now())

  @@index([segmentId, elapsedTimeSec])
  @@index([userId, segmentId])
  @@index([activityId])
  @@map("segment_efforts")
}

// ─── PERSONAL RECORDS ────────────────────────────────────

model PersonalRecord {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sportType  SportActivityType @default(RUN)
  type       PRType
  value      Float             // seconds for timed benchmarks, km for longest distance, sec/km for pace
  activityId String
  activity   RunSession        @relation(fields: [activityId], references: [id], onDelete: Cascade)
  achievedAt DateTime          @default(now())
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([userId, sportType, type])
  @@index([userId])
  @@index([type])
  @@map("personal_records")
}

enum PRType {
  BEST_1K
  BEST_5K
  BEST_10K
  HALF_MARATHON
  MARATHON
  LONGEST_DISTANCE
  FASTEST_PACE
}

// ─── ATHLETE GOALS ───────────────────────────────────────

model AthleteGoal {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sportType    SportActivityType @default(RUN)
  period       GoalPeriod        @default(WEEKLY)
  targetType   GoalTargetType    @default(DISTANCE_KM)
  targetValue  Float
  currentValue Float             @default(0)
  startDate    DateTime
  endDate      DateTime
  isCompleted  Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId, period, startDate])
  @@map("athlete_goals")
}

enum GoalPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

enum GoalTargetType {
  DISTANCE_KM
  DURATION_MIN
  ACTIVITIES_COUNT
}

// ─── ACTIVITY KUDOS ──────────────────────────────────────

model ActivityKudos {
  id           String     @id @default(cuid())
  runSessionId String
  runSession   RunSession @relation(fields: [runSessionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([runSessionId, userId])
  @@index([runSessionId])
  @@index([userId])
  @@map("activity_kudos")
}

// ─── PRIVACY ZONES ───────────────────────────────────────

model PrivacyZone {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String   @default("Home")
  lat          Float
  lng          Float
  radiusMeters Float    @default(500)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("privacy_zones")
}

// ─── CLUBS ───────────────────────────────────────────────

model Club {
  id          String            @id @default(cuid())
  name        String
  description String?
  coverUrl    String?
  avatarUrl   String?
  city        String?
  country     String?
  sportType   SportActivityType @default(RUN)
  isPrivate   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  members    ClubMember[]
  posts      ClubPost[]
  challenges Challenge[]

  @@index([sportType])
  @@index([city])
  @@map("clubs")
}

enum ClubRole {
  MEMBER
  ADMIN
  OWNER
}

model ClubMember {
  id       String   @id @default(cuid())
  clubId   String
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     ClubRole @default(MEMBER)
  joinedAt DateTime @default(now())

  @@unique([clubId, userId])
  @@index([userId])
  @@map("club_members")
}

model ClubPost {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  mediaUrls String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
  @@map("club_posts")
}

// ─── CHALLENGES & BADGES ─────────────────────────────────

model Challenge {
  id           String            @id @default(cuid())
  title        String
  description  String
  badgeKey     String?
  badgeIconUrl String?
  type         ChallengeType     @default(MONTHLY_DISTANCE)
  targetValue  Float
  sportType    SportActivityType @default(RUN)
  startDate    DateTime
  endDate      DateTime
  clubId       String?
  club         Club?             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  participants UserChallenge[]
  createdAt    DateTime          @default(now())

  @@index([startDate, endDate])
  @@map("challenges")
}

enum ChallengeType {
  MONTHLY_DISTANCE
  ELEVATION_GAIN
  WEEKLY_STREAK
  SINGLE_ACTIVITY_DISTANCE
}

model UserChallenge {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  progress    Float     @default(0)
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  joinedAt    DateTime  @default(now())

  @@unique([userId, challengeId])
  @@index([userId])
  @@map("user_challenges")
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeKey    String
  title       String
  description String
  iconUrl     String?
  awardedAt   DateTime @default(now())

  @@unique([userId, badgeKey])
  @@index([userId])
  @@map("user_badges")
}

// ─── EVENT SERIES & FINISHER RESULTS ─────────────────────

model EventSeries {
  id          String   @id @default(cuid())
  title       String
  description String?
  frequency   String   @default("WEEKLY")
  organizerId String
  createdAt   DateTime @default(now())

  events Event[]

  @@map("event_series")
}

model EventFinisherResult {
  id          String      @id @default(cuid())
  eventId     String
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId  String?
  activity    RunSession? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  rank        Int
  timeSec     Int
  distanceKm  Float
  paceSec     Int
  completedAt DateTime    @default(now())

  @@unique([eventId, userId])
  @@index([eventId, rank])
  @@map("event_finisher_results")
}

model EventAnnouncement {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([eventId])
  @@map("event_announcements")
}

